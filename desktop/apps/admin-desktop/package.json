{
  "name": "familyvault-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "dist/electron/main.cjs",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc && vite build && tsc -p electron/tsconfig.json && node scripts/rename-main.js",
    "build:safe": "pnpm build && node scripts/check-runtime-deps.js",
    "electron:build": "electron-builder -m",
    "electron:build:safe": "pnpm build:safe && pnpm electron:build && node scripts/test-packaged-app.js",
    "check-deps": "node scripts/check-runtime-deps.js",
    "test-packaged": "node scripts/test-packaged-app.js",
    "analyze-form-data": "node scripts/analyze-form-data-deps.js",
    "install-form-data-deps": "node scripts/install-all-form-data-deps.js",
    "analyze-all-deps": "node scripts/comprehensive-dep-analyzer.js",
    "dep-summary": "node scripts/dependency-summary.js",
    "fix-all-deps": "node scripts/complete-dependency-resolver.js",
    "verify-build": "node scripts/final-verification.js",
    "diagnose-white-screen": "node scripts/diagnose-white-screen.js",
    "test-ui": "node scripts/test-ui-rendering.js",
    "white-screen-summary": "node scripts/white-screen-fix-summary.js",
    "diagnose-network": "node scripts/diagnose-network-error.js",
    "test-frontend-api": "node scripts/test-frontend-api.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@familyvault/shared": "workspace:*",
    "@familyvault/ui": "workspace:*",
    "@hookform/resolvers": "^3.3.0",
    "@tanstack/react-query": "^5.17.0",
    "asynckit": "^0.4.0",
    "axios": "^1.6.0",
    "call-bind-apply-helpers": "^1.0.2",
    "clsx": "^2.0.0",
    "combined-stream": "^1.0.8",
    "delayed-stream": "^1.0.0",
    "diskusage": "^1.2.0",
    "drivelist": "^12.0.2",
    "dunder-proto": "^1.0.1",
    "es-define-property": "^1.0.1",
    "es-errors": "^1.3.0",
    "es-object-atoms": "^1.1.1",
    "es-set-tostringtag": "^2.1.0",
    "file-saver": "^2.0.5",
    "follow-redirects": "^1.15.11",
    "form-data": "^4.0.0",
    "function-bind": "^1.1.2",
    "get-intrinsic": "^1.3.0",
    "get-proto": "^1.0.1",
    "gopd": "^1.2.0",
    "has-symbols": "^1.1.0",
    "has-tostringtag": "^1.0.2",
    "hasown": "^2.0.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.452.0",
    "math-intrinsics": "^1.1.0",
    "mime-db": "^1.54.0",
    "mime-types": "^3.0.1",
    "proxy-from-env": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^2.10.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.22.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^23.0.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.familyvault.desktop",
    "productName": "FamilyVault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "build/backend/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/asynckit/**/*",
      "node_modules/axios/**/*",
      "node_modules/call-bind-apply-helpers/**/*",
      "node_modules/combined-stream/**/*",
      "node_modules/delayed-stream/**/*",
      "node_modules/diskusage/**/*",
      "node_modules/drivelist/**/*",
      "node_modules/dunder-proto/**/*",
      "node_modules/es-define-property/**/*",
      "node_modules/es-errors/**/*",
      "node_modules/es-object-atoms/**/*",
      "node_modules/es-set-tostringtag/**/*",
      "node_modules/follow-redirects/**/*",
      "node_modules/form-data/**/*",
      "node_modules/function-bind/**/*",
      "node_modules/get-intrinsic/**/*",
      "node_modules/get-proto/**/*",
      "node_modules/gopd/**/*",
      "node_modules/has-symbols/**/*",
      "node_modules/has-tostringtag/**/*",
      "node_modules/hasown/**/*",
      "node_modules/keytar/**/*",
      "node_modules/math-intrinsics/**/*",
      "node_modules/mime-db/**/*",
      "node_modules/mime-types/**/*",
      "node_modules/proxy-from-env/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true
    },
    "protocols": [
      {
        "name": "FamilyVault Pairing",
        "schemes": [
          "familyvault"
        ]
      }
    ]
  },
  "optionalDependencies": {
    "node-addon-api": "^8.5.0",
    "prebuild-install": "^7.1.3"
  }
}